# Rune Weaver — unified build entrypoint for the Swift engine and web dashboard.
#
# Toolchain:
#   - Swift 6.4 on macOS 26+ builds, tests, lints, and runs the engine.
#   - Node.js 20+ with npm is required only at build time to compile the
#     React + TypeScript + Vite dashboard in Web/ to static files in Web/dist.
#     There is no runtime Node server; the engine serves Web/dist on loopback.
#
# Common flows:
#   make setup            # clean install dependencies for Web and Swift
#   make build            # Swift engine + dashboard bundle (Web/dist)
#   make test             # Swift tests + dashboard tests (vitest)
#   make lint             # Swift style gates + dashboard typecheck, ESLint (TS/CSS), and file budgets
#   make audit            # security audit for Web dashboard and Swift dependencies
#   make run ARGS="chat"  # launch the engine (extra args pass through)
#   make all              # build + test + lint (default)
#   make clean            # remove build outputs

.DEFAULT_GOAL := all

.PHONY: all setup setup-web setup-swift build build-web build-swift test test-web test-swift lint lint-web lint-swift audit audit-web audit-swift run app dmg clean version

all: build test lint

setup: setup-web setup-swift

setup-web:
	cd Web && (if [ -f package-lock.json ]; then npm ci; else npm install; fi)

setup-swift:
	swift package resolve
	@which swiftformat >/dev/null 2>&1 || echo "swiftformat not found: install with 'brew install swiftformat' (required for 'make lint-swift')"
	@which swiftlint >/dev/null 2>&1 || echo "swiftlint not found: install with 'brew install swiftlint' (required for 'make lint-swift')"
	@which osv-scanner >/dev/null 2>&1 || which trivy >/dev/null 2>&1 || echo "osv-scanner not found: install with 'brew install osv-scanner' (required for 'make audit-swift')"

# Single-source version: stamps the Swift constant from VERSION and syncs the
# dashboard manifest, so the engine, CLI, /health, and package.json cannot drift.
# The dashboard reads the version at runtime from /health.version.
# The stamped file is gitignored; fresh clones bootstrap it via `make version`
# (a prereq of build-swift, test-swift, and run), so never edit it by hand.
version:
	@VERSION=$$(tr -d '[:space:]' < VERSION | sed 's/^[vV]//'); \
	if [ -z "$$VERSION" ]; then echo "VERSION file is empty or missing" >&2; exit 1; fi; \
	if ! printf '%s' "$$VERSION" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$$'; then echo "VERSION must be X.Y.Z semver (got '$$VERSION')" >&2; exit 1; fi; \
	printf '%s\n' \
		'// Rune Weaver Core — Stamped engine version generated from the repo-root VERSION file.' \
		'//' \
		'// Carries the canonical release string so the Swift engine, CLI, and service' \
		'// surface share one version without hand-edited literals drifting.' \
		'// This file is generated by `make version`; do not edit by hand.' \
		'' \
		'/// Engine version stamped from VERSION at build time.' \
		'public enum RuneWeaverGeneratedVersion: Sendable {' \
		'    /// Canonical release string (X.Y.Z) read from the repo-root VERSION file.' \
		"    public static let version = \"$$VERSION\"" \
		'}' \
		> Sources/RuneWeaverCore/GeneratedVersion.swift; \
	echo "Stamped Sources/RuneWeaverCore/GeneratedVersion.swift with $$VERSION"; \
	cd Web && npm version "$$VERSION" --no-git-tag-version --allow-same-version

build: build-web build-swift

build-web:
	@test -d Web/node_modules || $(MAKE) setup-web
	cd Web && npm run build

build-swift: version
	swift build

test: test-web test-swift

test-web: export RUNEWEAVER_HERMETIC_TESTS=1
test-web:
	@test -d Web/node_modules || $(MAKE) setup-web
	cd Web && RUNEWEAVER_HERMETIC_TESTS=1 VITEST_SKIP_INSTALL_CHECKS=1 npm test

test-swift: export RUNEWEAVER_HERMETIC_TESTS=1
test-swift: version
	RUNEWEAVER_HERMETIC_TESTS=1 swift test

lint: lint-web lint-swift

# Web lint runs TypeScript compiler checks, ESLint (TS & CSS), and file budget enforcement.
lint-web:
	@test -d Web/node_modules || $(MAKE) setup-web
	cd Web && npm run typecheck
	cd Web && npm run lint

lint-swift:
	swiftformat --lint .
	swiftlint lint

audit: audit-web audit-swift

audit-web:
	@test -d Web/node_modules || $(MAKE) setup-web
	cd Web && npm audit --audit-level=high

audit-swift:
	@test -f Package.resolved || swift package resolve
	@if which osv-scanner >/dev/null 2>&1; then \
		osv-scanner scan --lockfile=Package.resolved; \
	elif which trivy >/dev/null 2>&1; then \
		trivy fs --scanners vuln Package.resolved; \
	else \
		echo "Neither osv-scanner nor trivy found: install with 'brew install osv-scanner' (or 'brew install trivy') to audit Swift packages." >&2; \
		exit 1; \
	fi

run: version
	swift run rune-weaver $(ARGS)

app: version
	bash scripts/build_app.sh

dmg:
	bash scripts/build_dmg.sh

clean:
	rm -rf .build Web/dist dist

