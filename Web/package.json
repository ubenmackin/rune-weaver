{
  "name": "rune-weaver-dashboard",
  "private": true,
  "version": "0.1.0",
  "description": "Static web dashboard for the Rune Weaver engine. Compiled once with npm and served by the engine on the same loopback origin.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^24.1.0",
    "typescript": "~5.5.4",
    "vite": "^6.4.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.9"
  }
}
