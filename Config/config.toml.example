# ~/.runeweaver/config.toml
# Copy to ~/.runeweaver/config.toml and adjust. Secrets live in the
# macOS Keychain (service: com.runeweaver.secrets) or environment
# variables, never in this file.

[engine]
name = "Rune Weaver"
log_level = "info"  # trace | debug | info | notice | warning | error | critical
# compaction_threshold_percent = 80  # Context compaction threshold in percent (10-100); oldest turns fold into a rolling summary past this budget.
# max_tool_iterations = 10  # Max consecutive tool rounds per turn before continuation approval (1-100).

[server]
# Engine HTTP API bind endpoint. Loopback is the v1 default. A non-loopback
# hostname is refused at boot unless owner auth resolves a token (auth-before-
# exposure): the service never silently downgrades to an unauthenticated LAN bind.
# A refused bind is visible in the menu-bar app status line (Failed reason plus
# Open Settings / Retry), so a 0.0.0.0-without-token refusal is fixable without Terminal.
#
# Reaching the engine from a phone or another machine: prefer a WireGuard (or
# equivalent) tunnel and leave this hostname on 127.0.0.1. The tunnel keeps the
# engine off the physical LAN while the bearer token still guards every request.
# Binding a raw LAN address is allowed only once a token resolves and exposes
# the service to every host that can route to it, so only do that on a trusted
# network you control.
#
# Literal LAN IP vs all-interfaces: binding this Mac's literal LAN IP (for
# example "192.168.1.20") is the narrow workaround — that address alone joins
# the Host allowlist beside loopback, so only that exact Host passes and
# neighbors still answer 403. Binding "0.0.0.0" (or "::") listens on every
# interface and, once a token resolves, additionally admits the LAN family:
# 10/8, 172.16/12, 192.168/16, 169.254/16, IPv6 ULA plus link-local, and
# ".local" names, plus any explicit allowed_hosts below. Without a token the
# all-interfaces bind is refused at boot rather than served open.
#
# allowed_hosts admits extra exact hostnames beside loopback and the bind
# hostname (for example a Tailscale name). Entries are exact-only after
# lowercasing plus port stripping: one host per entry, no scheme ("https://"),
# no wildcards ("*.example.com"), no CIDR ("192.168.1.0/24"), no bare "*",
# no userinfo, query, fragment, whitespace, or control characters. At most 20
# entries of at most 253 characters each; anything wider fails closed at load
# and a hand-built widening entry is dropped by the Host gate itself.
hostname = "127.0.0.1"
port = 8082
# allowed_hosts = ["my-mac.tail123.ts.net"]

[auth]
# Single-owner bearer auth. The token value itself must never live in this
# file. Resolution order: the explicit token_env override below, then the
# Keychain account RUNEWEAVER_AUTH_TOKEN (service com.runeweaver.secrets,
# which itself prefers a same-named environment variable for headless runs),
# then the 0600 file fallback. Resolved tokens are never logged. Non-loopback
# binds require a resolvable token.
#
# First run from the menu-bar .app (no Terminal needed):
#   1. Launch the app; loopback stays usable while no token is stored.
#   2. The menu Server section reads "local use only" — open Settings.
#   3. Generate the owner token and copy the once-only value immediately.
#   4. Acknowledge "I saved it" to restart the embedded service and adopt it.
#   5. Only then set [server] hostname to the literal LAN IP or "0.0.0.0";
#      without the stored token that bind stays refused with a Failed reason
#      in the menu plus a Retry action.
#
# Rotating the token (do this after enabling a LAN or tunnel bind):
#   Settings: use the "Rotate access token" control in the dashboard Settings
#             pane while signed in. This rotates the running engine in place:
#             the previous token stops working immediately and every other
#             signed-in browser or device is logged out on its next request.
#             The new value is shown exactly once — copy it then; it is never
#             displayed again. Paste it into your password manager before
#             acknowledging or navigating away; a lost copy cannot be re-shown
#             and the only recovery is another rotation.
#   CLI:      rune-weaver auth token rotate   (add --yes for scripts)
#             rune-weaver auth token generate (first token; refuses to overwrite)
#             rune-weaver auth token status   (which source resolves, no secret)
#             The CLI runs in its own process and only rewrites the stored
#             credential. A running engine caches its token at boot, so restart
#             serve (or the menu-bar app) for the replacement to take effect;
#             until then the previous token still works. Use the dashboard
#             control above when the live token must be revoked immediately.
# Store the new value in your password manager.
# token_env = "RUNEWEAVER_AUTH_TOKEN"
# token_file = "~/.runeweaver/auth_token"

[llm]
default_provider = "mlx"
fallback_provider = "openrouter"

[llm.providers.mlx]
enabled = true
model = "gemma-4-9b"
server_url = "http://localhost:8080"  # MLX server (engine API binds 127.0.0.1:8082 to avoid colliding here; llama.cpp uses 8081)
# context_length = 8192  # Context window in tokens (MLX backend default 8192)

[llm.providers.openrouter]
enabled = true
api_key_env = "OPENROUTER_API_KEY"  # Reads from env or Keychain
server_url = "https://openrouter.ai/api/v1"
# api_style = "chat-completions"  # chat-completions (default) | responses
# context_length = 128000  # Context window in tokens (e.g. 1000000 for 1M-context endpoints)

[llm.providers.local]
enabled = false
provider_type = "llamacpp"
server_url = "http://localhost:8081"
# context_length = 4096  # Context window in tokens (llama.cpp backend default 4096)
# slot_count = 4  # sticky id_slot pool size; match llama-server --parallel to opt into prefix reuse (omit for server auto-assign)
# cache_prompt = true  # prefix-cache hint (omit for default enabled; set false to disable)

[memory]
vector_db_path = "~/.runeweaver/memory/vectors"
episodes_db_path = "~/.runeweaver/memory/episodes.db"
embedding_model = "all-MiniLM-L6-v2"
# embedding_model is retained for forward compatibility but currently unused:
# "apple" uses the fixed on-device model with no model config, "provider"
# reuses the active chat model via /v1/embeddings, and "none" stays
# keyword-only with no vectors.
# embedding_backend selects the vector backend: "apple" (on-device, local-first default),
# "provider" (active chat model embeddings), or "none" (keyword-only, no vectors).
# Switching chat models under "provider" may require a vector reset due to width pinning.
embedding_backend = "apple"
# Recall budgets bounding automatic and explicit recall fan-out. Flat keys under
# [memory]; absent keys keep the documented defaults. Out-of-range values clamp
# to the nearest bound instead of refusing to boot.
# recall_per_tier_limit = 5  # Max hits fetched per tier before merging (1-50).
# recall_auto_limit = 5  # Max hits injected as system context per auto turn (1-50).
# recall_threshold = 0.1  # Min calibrated score for an injected hit (0.0-1.0).
# recall_max_chars = 2000  # Max chars for the injected recall block, header included (200-16000).
# recall_per_hit_chars = 500  # Max chars kept per hit before ellipsis truncation (100-2000).
# recall_doc_pool_multiplier = 4  # Extra vector candidates scanned per returned document page (1-8).
# recall_episodic_weight = 0.25  # Weight mapping episodic rank onto the shared recall scale (0.0-1.0).

[voice]
stt_provider = "whisper"
whisper_model = "base"
tts_provider = "system"  # macOS say command

[sandbox]
# Tier-3 detonation only: there is no host staging. Legacy staging keys
# (staging_path, retention_days, max_total_bytes, cleanup_interval_seconds)
# in older files are ignored with no migration; manually clean old dev-only
# staging directories.
# Archive detonation always uses the Apple Container CLI ("container");
# there is no container_runtime key. Older files carrying the key load
# with the hardcoded default.
# Default OCI base image for quarantine/detonation chambers.
container_base_image = "alpine:latest"
# Crash-orphan reclamation TTL in minutes for ephemeral detonation machines (10 default).
# Detonations are reaped immediately; the sweeper reclaims only machines orphaned by crashes.
archive_session_ttl_minutes = 10
# Maximum concurrent container machines allowed at once (3 default).
max_concurrent_machines = 3

[files]
# Sensitive-path deny list for file tools, mirroring the engine guard.
# Glob-like: `*` matches within a name, `dir/*` guards a subtree.
# Changes apply live without a restart.
# List order is display-only: reordering entries never changes the decision.
# Live evaluation is deny-then-containment: a deny match denies first
# (escalating or failing per require_approval_on_deny below), otherwise a path
# inside any allow root is allowed, otherwise it denies as outside-roots.
# Denied paths are skipped everywhere including the document index.
deny_patterns = [".env*", ".netrc", "secrets.json", "config.toml", "*.pem", "*.key", "*keychain*", ".ssh/*", ".aws/*", ".runeweaver/memory/vectors/*", ".git-credentials", ".gitcookies", ".rclone.conf", ".npmrc", ".pypirc", ".Xauthority", ".emulator_console_auth_token", ".gnupg/*", ".kube/*", ".docker/*", ".config/gcloud/*", ".chia_keys/*", "*_history", ".zsh_sessions/*"]
# Allowed roots for live file access (`~` expands to home); outside-root paths
# escalate to approval. Order is display-only and never changes the decision.
# Allow roots bound live access only and do not affect index coverage:
# index coverage is driven by [index].roots, which walks its own roots while
# still skipping denied paths.
allow_roots = ["~"]
# Whether deny hits escalate to the approvals inbox (true) or fail closed.
require_approval_on_deny = true

[index]
# Local background indexer for files, mail, and messages. Off by default so a
# fresh install never reads a mailbox or walks the home directory until you opt
# in. The index stores content and derived vectors only; credentials never live
# here and are resolved through the Keychain at run time.
enabled = false
# Per-source toggles. File indexing is on once the indexer is enabled; mail and
# Apple Messages stay off until you set them true.
files = true
mail = false
messages = false
# Root directories scanned for files (`~` expands to home).
roots = ["~"]
# Glob patterns skipped during a file scan (build output, machine-output files,
# and package-manager, model, and agent tool caches) so the walk never descends
# into material it should not index. These are ordinary editable globs that seed
# the Index Policy "Exclude patterns" editor: read and change them there, where
# they persist into [index].exclude. Matching is case-insensitive, so an
# uppercase .LOG is covered, and bare directory names match at any depth.
# Media libraries (Music, Pictures, Movies), Library, .Trash, the app's own
# .runeweaver state, and VCS, dependency, build, and cache trees (Music,
# Pictures, Movies, Library, .Trash, .runeweaver, .git, node_modules,
# DerivedData, __pycache__, .venv) are always skipped in addition to these and
# cannot be removed by configuration; they appear in the Index Policy scope copy
# rather than duplicated here.
exclude = [".build", "*.app", "*.log", "*.tmp", ".DS_Store", ".bun", ".cocoapods", ".npm", ".npm-packages", ".nvm", ".cache", ".gradle", ".swiftpm", ".swiftly", ".gem", ".rvm", ".cpan", ".local", ".docker", ".ollama", ".terraform.d", ".ipynb_checkpoints", ".ipython", ".jupyter", ".matplotlib", ".vscode", ".vscode-insiders", ".zsh_sessions", "gopath", "go", "nltk_data"]
# Largest file the indexer will read, in megabytes (1-10240).
max_file_mb = 20
# How far back mail is vectorized: 30d | 6m | 1y | 2y | all ("all" disables the window).
# Mail older than the window stays indexed and keyword-searchable, and backfill can add
# its vectors later.
mail_vector_window = "2y"
# iCloud files whose bytes are evicted: "skip" (default) or "download".
# Skip avoids silently pulling a file down during an index run.
icloud_evicted = "skip"
# Describe image files with the configured LLM. Off by default; enabling it
# sends image content to the active provider.
describe_images_with_llm = false
# Maximum items processed per nightly run; 0 means unlimited (0-100000).
nightly_budget = 0
# Maximum chunks per document that carry vectors (1-4096, default 128). Longer
# documents keep every chunk keyword-searchable and vectorize only the first
# N chunks in document order, so a capped document stays fully findable by
# keyword.
max_vector_chunks_per_document = 128
# Trash-class mailboxes skipped without dialing (one glob per entry).
# Matching is case-insensitive against the full mailbox name plus every
# slash-separated hierarchy segment, so "Trash" covers "Trash" and
# "INBOX/Trash" while "Deleted*" covers "Deleted Messages". Denied mail
# retires on the next complete run and re-indexes from scratch when re-allowed;
# clearing the list opts every mailbox back in.
mailbox_deny = ["Trash", "Junk", "Spam", "Deleted*"]
# Run effort: "light" (1 worker) | "balanced" (half the cores, up to 4) |
# "performance" (all but one core) | "custom" (explicit `workers` count).
# Resolved once at run start; thermal pressure can back the run off below it.
effort = "balanced"
# Explicit worker count for `effort = "custom"` (1-64, clamped to the core
# count at run start). Leave at 0 for the scaling presets, which derive the
# count from the preset.
# workers = 0
# Whether indexing backs off when the system reports thermal pressure.
thermal_backoff = true
# Pause runs while on battery power and resume on AC. Committed batches are kept.
pause_on_battery = false
# SQLite path for the index database.
db_path = "~/.runeweaver/index.db"

[browser]
# Local web search and fetch policy. Search runs against self-hosted SearXNG
# over its JSON API so queries never leave operator infrastructure.
# The engine ensures SearXNG on `serve` boot and first search (bounded 10s,
# single-flight); the container stays running after quit by design.
# Start manually with `scripts/searxng-up.sh` when the engine cannot.
searxng_url = "http://127.0.0.1:8888"
# Per-search HTTP timeout in seconds (1-120).
search_timeout_seconds = 10
# Maximum results per web.search call (1-50, bounding context fan-out).
max_results = 10

[desktop]
# Native macOS perception and gated automation. Both tools always register
# (visible but disabled) and enablement flows solely through the persisted
# tool-state toggle, which is the sole authority: a tool stays disabled
# until an operator enables it (dashboard Tools tab / tool-state API).
# This section carries only capture knobs and never gates enablement.
# Retired `screen_capture_enabled`, `control_enabled`, and legacy `enabled`
# keys are silently ignored when present so old files load without migration.
# Captures are in-memory downscaled JPEGs; control batches park in the
# approvals inbox.
# Longest edge of the downscaled screenshot in pixels (256-3840). Bounds
# vision-model token cost.
max_image_dimension = 1280
# JPEG quality for the downscaled screenshot (0.1-1.0).
jpeg_quality = 0.75
# Application names desktop.action refuses to dispatch input to, protecting
# sensitive apps from automated clicks and keystrokes.
blocked_apps = ["Terminal", "iTerm2", "Keychain Access", "System Settings", "System Preferences", "1Password", "Bitwarden"]

[bash]
# Commands run in the engine home directory by default, with an optional
# per-call `cwd` override inside allowed roots, confined by the Seatbelt
# sandbox (sandbox-exec, deny-default; not Apple Container).
# Granular shell execution policy. Rules evaluate top-to-bottom and the
# last matching rule decides (last-match-wins): put the catch-all first
# and specifics after, otherwise a leading specific is shadowed by the
# catch-all below it.
# Example (last-match): `* = deny` first plus `swiftformat * = allow`
# later allows `swiftformat .`; reversed order denies.
enabled = true
# Default action when no rule matches: allow | ask | deny.
default_action = "ask"
# Default execution timeout in seconds (1-3600).
timeout_seconds = 30
# Whether commands may use the network inside the sandbox.
allow_network = false

[[bash.rules]]
pattern = "*"
action = "ask"

[[bash.rules]]
pattern = "git status"
action = "allow"

[email]
[[email.accounts]]
name = "icloud"
type = "imap"
host = "imap.mail.me.com"
port = 993
username = "user@icloud.com"
# password stored in Keychain
# Optional SMTP overrides (omit for auto: derived host on 587 STARTTLS then 465 SSL, verified TLS only).
# smtp_host = "smtp.mail.me.com"
# smtp_port = 587
# smtp_security = "auto"  # ssl | starttls | auto (default auto)

[[email.accounts]]
name = "personal"
type = "imap"
host = "mail.yourdomain.com"
port = 993
username = "you@yourdomain.com"
# password stored in Keychain
# Optional SMTP overrides (omit for auto: same host on 587 STARTTLS then 465 SSL, verified TLS only).
# smtp_host = "mail.yourdomain.com"
# smtp_port = 587
# smtp_security = "auto"  # ssl | starttls | auto (default auto)

[home]
[[home.homekit]]
enabled = true

[[home.home_assistant]]
enabled = true
url = "http://homeassistant.local:8123"
token_env = "HA_TOKEN"  # Reads from env or Keychain

[scheduler]
# Cron fires use five-field expressions (minute hour day month weekday)
# or @hourly / @daily / @weekly / @monthly / @yearly. Poll entries watch
# one [email.accounts] entry for unseen arrivals. A job fires on either
# trigger when both are set. Headless turns run under the stable job
# session with source "scheduler", log to the run log, and post a macOS
# notification; gated writes file pending approvals instead of prompting.
# Known v1 limitation: single-flight is per-process only (CLI foreground
# loop vs. engine API manual runs share no lock), so the same job name can
# still run concurrently via API plus CLI — do not run both for one job.

[[scheduler.jobs]]
name = "morning digest"
schedule = "0 8 * * *"
prompt = "Summarize overnight mail and today's calendar"
enabled = true

# [[scheduler.jobs]]
# name = "invoice watcher"
# prompt = "Summarize new invoices and file pending approvals for review"
# enabled = true
# poll_account = "personal"
# poll_query = "invoice"
# # poll_mailbox = "INBOX"  # omitted means every selectable mailbox
# poll_interval_seconds = 300

# -----------------------------------------------------------------------------
# Plugins & Runes
# -----------------------------------------------------------------------------
# External tool discovery and community marketplace configuration.
# Discovered runes enter the system in a disabled state awaiting user approval.
# Runes execute as sandboxed subprocesses via JSON-RPC 2.0 over stdin/stdout.

[plugins]
plugins_dir = "~/.runeweaver/plugins"
marketplace_index_url = "https://raw.githubusercontent.com/ubenmackin/rune-weaver-marketplace/main/index.json"
auto_rescan = true

# -----------------------------------------------------------------------------
# Home Media (Sonarr & Radarr)
# -----------------------------------------------------------------------------
# Integration with self-hosted Sonarr (TV shows) and Radarr (movies).
# API keys are read from environment variables or Keychain, never stored here.
# Defaults are enabled = true with no URL (matching RuneWeaverConfig defaults):
# enabled with no URL stays unconfigured — the tool reports guidance and never
# dials — so set url to activate against a running instance.

[media.sonarr]
enabled = true
url = "http://localhost:8989"
api_key_env = "SONARR_API_KEY"
# default_quality_profile = "HD-1080p"
# default_root_folder = "/data/media/tv"

[media.radarr]
enabled = true
url = "http://localhost:7878"
api_key_env = "RADARR_API_KEY"
# default_quality_profile = "HD-1080p"
# default_root_folder = "/data/media/movies"

[goals]
# Steady long-horizon pursuit. Off by default so a fresh install never spends
# planning calls or scheduler turns until you opt in. Goals advance on
# `step_interval_minutes` cadence via the service worker and the CLI
# foreground loop; creation links the chat session so the dashboard can badge it.
enabled = false
# Cadence hint in minutes stored on each new goal (5-20160).
step_interval_minutes = 1440
# Maximum goals in the active state at once (1-50, bounds scheduler fan-out).
max_active_goals = 10
# Maximum steps in one decomposed plan (1-24, bounds planning context).
max_steps_per_goal = 12
# Seconds the planner waits on the model before the resilient single-step
# fallback keeps the goal (must stay positive).
plan_timeout_seconds = 60

[security]
# Harness-level defense policy for external content. Both keys default ON;
# an absent [security] section loads hardened so existing files need no
# migration. Every key renders on save so a round-trip never depends on an
# implicit default silently diverging from what was written.
# Untrusted labeling wraps network-derived tool output as data-only context
# (debugging off-switch only; false restores the pre-labeling shape byte-identically).
untrusted_labeling = true
# Credential filtering redacts one-time codes, magic links, and password-reset
# links from agent-visible mail while leaving the human inbox untouched
# (false passes mail through byte-identically).
email_credential_filter = true

